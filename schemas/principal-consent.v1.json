{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretary.local/schemas/principal-consent.v1.json",
  "title": "Secretary principal consent",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "decision", "created_at", "updated_at"],
  "properties": {
    "version": {"type": "string", "const": "secretary.principal-consent/1"},
    "revision": {"type": "integer", "minimum": 1},
    "decision": {"type": "string", "enum": ["persistent", "declined"]},
    "provider_use": {"type": "boolean"},
    "paused": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "persistent"}}},
      "then": {"required": ["provider_use", "paused"]}
    },
    {
      "if": {"properties": {"decision": {"const": "declined"}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["provider_use"]},
            {"required": ["paused"]}
          ]
        }
      }
    }
  ]
}
