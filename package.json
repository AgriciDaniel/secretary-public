{
  "name": "secretary",
  "version": "0.2.0",
  "description": "Evidence-grounded AI secretary for Claude Code and Codex, with frozen context, deterministic retrieval, bounded quality review, and explicit human approval gates.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "agent-orchestration",
    "agentic-workflows",
    "ai-agents",
    "ai-secretary",
    "chief-of-staff",
    "claude-code",
    "codex",
    "evidence-based",
    "executive-assistant",
    "human-in-the-loop",
    "knowledge-base",
    "local-first",
    "multi-agent-systems",
    "nodejs",
    "obsidian",
    "prompt-injection",
    "quality-assurance",
    "research-assistant",
    "staff-work",
    "workflow-automation"
  ],
  "engines": {"node": ">=20"},
  "repository": {"type": "git", "url": "https://github.com/AgriciDaniel/secretary-public.git"},
  "homepage": "https://github.com/AgriciDaniel/secretary-public#readme",
  "bugs": {"url": "https://github.com/AgriciDaniel/secretary-public/issues"},
  "scripts": {
    "generate": "node scripts/generate-surfaces.mjs && node scripts/generate-brain-manifest.mjs && node scripts/generate-source-ledger.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:links": "node scripts/check-links.mjs",
    "release:check": "node scripts/release-hygiene.mjs",
    "release:check:worktree": "node scripts/release-hygiene.mjs --include-untracked",
    "private:archive": "node scripts/release-hygiene.mjs --private-output release/private/secretary-canonical-tracked.tar.gz",
    "public:export": "node scripts/public-export.mjs --output release/secretary-public",
    "public:verify": "node scripts/public-export.mjs --verify release/secretary-public",
    "public:ready": "node scripts/public-ready.mjs",
    "public:archive": "node scripts/public-archive.mjs --source release/secretary-public --output release/secretary-public.tar.gz",
    "test": "node scripts/test.mjs",
    "test:live": "node tests/live-smoke.mjs",
    "test:behaviour": "node --test tests/behaviour/",
    "test:adversarial:static": "node --test tests/adversarial/adversarial.test.mjs",
    "test:adversarial:live": "node tests/adversarial/live.mjs",
    "check:source-types": "node scripts/check-source-types.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:evidence:support": "node scripts/check-evidence.mjs --require-human-support",
    "release:ready": "npm run check:generated && npm run check:links && npm run check:source-types && npm run check:evidence:support && npm test && npm run release:check",
    "report:evidence": "node scripts/check-evidence.mjs --report"
  }
}
