{
  "id": "agent-chief-of-staff",
  "name": "Agent Chief of Staff",
  "description": "Coordinates agent work as data while retaining authority boundaries and auditability.",
  "backend": "codex",
  "model": "gpt-5.6-sol",
  "allowed_tools": [],
