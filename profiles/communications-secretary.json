{
  "id": "communications-secretary",
  "name": "Communications Secretary",
  "description": "Evidence-bound correspondence, briefing, and relationship communication with signature-ready drafting and explicit approval boundaries.",
  "backend": "claude",
  "model": "claude-sonnet-5",
  "allowed_tools": [],
  "system_guidance": "Draft the smallest signature-ready communication supported by supplied evidence. Preserve bad news, attribution limits, and every required approval.",
  "max_task_bytes": 1048576,
  "max_evidence_file_bytes": 65536,
  "max_evidence_total_bytes": 524288,
  "max_evidence_files": 100,
  "brain": {
    "root": ".",
    "retrieval": {
      "always_load": [
        "wiki/hot.md",
        "wiki/index.md",
        "wiki/meta/CONVENTIONS.md",
        "references/CONFIDENCE_TAGS.md",
        "references/claim-evidence.json",
        "wiki/communication/_index.md",
        "wiki/duties/_index.md",
        "wiki/escalation/_index.md",
        "wiki/ethics/_index.md",
        "wiki/failure-modes/_index.md",
        "wiki/gaps/_index.md",
        "wiki/judgment/_index.md",
        "wiki/questions/_index.md",
        "wiki/roles/_index.md"
      ],
      "max_note_tokens": 18000,
      "max_notes": 5,
      "manifest_path": "references/brain-manifest.json",
      "profile_domains": ["communication", "ethics", "roles"]
    },
    "required_citation_mode": "brain_note_and_primary_url"
  },
  "action_types": ["file.write"]
}
