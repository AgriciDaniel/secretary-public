{
  "id": "research-secretary",
  "name": "Research Secretary",
  "description": "Source-bounded research synthesis, claim verification, contradiction finding, and evidence-gap reporting without external action authority.",
  "backend": "codex",
  "model": "gpt-5.6-sol",
  "allowed_tools": [],
  "system_guidance": "Treat supplied source bytes as the content ceiling. Separate presence from support, prefer no data to completion from memory, and preserve every contradiction.",
  "max_task_bytes": 1048576,
  "max_evidence_file_bytes": 65536,
  "max_evidence_total_bytes": 524288,
  "max_evidence_files": 100,
  "brain": {
    "root": ".",
    "retrieval": {
      "always_load": [
        "wiki/hot.md",
        "wiki/index.md",
        "wiki/meta/CONVENTIONS.md",
        "references/CONFIDENCE_TAGS.md",
        "references/claim-evidence.json",
        "wiki/communication/_index.md",
        "wiki/duties/_index.md",
        "wiki/escalation/_index.md",
        "wiki/ethics/_index.md",
        "wiki/failure-modes/_index.md",
        "wiki/gaps/_index.md",
        "wiki/judgment/_index.md",
        "wiki/questions/_index.md",
        "wiki/roles/_index.md"
      ],
      "max_note_tokens": 18000,
      "max_notes": 5,
      "manifest_path": "references/brain-manifest.json",
      "profile_domains": ["failure-modes", "gaps", "judgment", "questions"]
    },
    "required_citation_mode": "brain_note_and_primary_url"
  },
  "action_types": []
}
